#include <stdint.h>

#include "stm32f103xb.h"
#include "FreeRTOS.h"
#include "task.h"
#include "queue.h"

/* =========================================================
 * CAU HINH PHAN CUNG
 * STM32F103C8T6
 *
 * LED1: PA0 - TIM2_CH1
 * LED2: PA1 - TIM2_CH2
 * LED3: PA2 - TIM2_CH3
 *
 * SELECT: PB12
 * UP:     PB13
 * DOWN:   PB14
 *
 * Nut nhan active-low, su dung dien tro pull-up noi.
 * ========================================================= */

#define LED1_PIN       0U
#define LED2_PIN       1U
#define LED3_PIN       2U

#define BUTTON_SELECT  12U
#define BUTTON_UP      13U
#define BUTTON_DOWN    14U

#define LED_COUNT      3U

#define PWM_PERIOD     999U
#define PWM_PRESCALER  71U

#define BRIGHTNESS_STEP 10U

/* Tan so he thong */
uint32_t SystemCoreClock = 8000000U;

/* =========================================================
 * BIEN QUEUE
 * ========================================================= */

static QueueHandle_t ledQueue[LED_COUNT];

/* =========================================================
 * KHAI BAO TASK
 * ========================================================= */

static void LED1_Task(void *argument);
static void LED2_Task(void *argument);
static void LED3_Task(void *argument);
static void Button_Task(void *argument);

/* =========================================================
 * SYSTEM INIT
 * ========================================================= */

void SystemInit(void)
{
    /*
     * Startup file co the goi SystemInit().
     * Clock se duoc cau hinh trong Clock_Init().
     */
}

void SystemCoreClockUpdate(void)
{
    /*
     * Clock duoc cap nhat trong Clock_Init().
     */
}

/* =========================================================
 * CAU HINH CLOCK 72 MHZ
 * HSE = 8 MHz
 * PLL = HSE * 9 = 72 MHz
 * ========================================================= */

static void Clock_Init(void)
{
    /* Bat HSE */
    RCC->CR |= RCC_CR_HSEON;

    while ((RCC->CR & RCC_CR_HSERDY) == 0U)
    {
    }

    /* Flash: prefetch + 2 wait states */
    FLASH->ACR = FLASH_ACR_PRFTBE | FLASH_ACR_LATENCY_2;

    /*
     * AHB  = SYSCLK / 1
     * APB1 = HCLK / 2
     * APB2 = HCLK / 1
     */
    RCC->CFGR &= ~(RCC_CFGR_HPRE |
                   RCC_CFGR_PPRE1 |
                   RCC_CFGR_PPRE2 |
                   RCC_CFGR_PLLSRC |
                   RCC_CFGR_PLLXTPRE |
                   RCC_CFGR_PLLMULL);

    RCC->CFGR |= RCC_CFGR_PPRE1_DIV2;
    RCC->CFGR |= RCC_CFGR_PLLSRC;
    RCC->CFGR |= RCC_CFGR_PLLMULL9;

    /* Bat PLL */
    RCC->CR |= RCC_CR_PLLON;

    while ((RCC->CR & RCC_CR_PLLRDY) == 0U)
    {
    }

    /* Chuyen SYSCLK sang PLL */
    RCC->CFGR &= ~RCC_CFGR_SW;
    RCC->CFGR |= RCC_CFGR_SW_PLL;

    while ((RCC->CFGR & RCC_CFGR_SWS) != RCC_CFGR_SWS_PLL)
    {
    }

    SystemCoreClock = 72000000U;
}

/* =========================================================
 * GPIO INIT
 * PA0-PA2: Alternate Function Push-Pull
 * PB12-PB14: Input Pull-up
 * ========================================================= */

static void GPIO_Init(void)
{
    /* Bat clock GPIOA, GPIOB va AFIO */
    RCC->APB2ENR |= RCC_APB2ENR_IOPAEN |
                    RCC_APB2ENR_IOPBEN |
                    RCC_APB2ENR_AFIOEN;

    /*
     * PA0, PA1, PA2:
     * MODE = 11: Output 50 MHz
     * CNF  = 10: Alternate function push-pull
     *
     * Moi chan dung 4 bit trong CRL.
     */
    GPIOA->CRL &= ~((0xFU << 0U) |
                    (0xFU << 4U) |
                    (0xFU << 8U));

    GPIOA->CRL |= ((0xBU << 0U) |
                   (0xBU << 4U) |
                   (0xBU << 8U));

    /*
     * PB12, PB13, PB14:
     * Input pull-up/pull-down
     *
     * Moi chan dung 4 bit trong CRH.
     */
    GPIOB->CRH &= ~((0xFU << 16U) |
                    (0xFU << 20U) |
                    (0xFU << 24U));

    GPIOB->CRH |= ((0x8U << 16U) |
                   (0x8U << 20U) |
                   (0x8U << 24U));

    /* ODR = 1 de chon pull-up */
    GPIOB->ODR |= (1U << BUTTON_SELECT) |
                  (1U << BUTTON_UP) |
                  (1U << BUTTON_DOWN);
}

/* =========================================================
 * TIMER 2 PWM INIT
 *
 * Timer clock = 36 MHz * 2 = 72 MHz
 * PSC = 71 -> counter clock = 1 MHz
 * ARR = 999 -> PWM frequency = 1 kHz
 * ========================================================= */

static void PWM_Init(void)
{
    /* Bat clock TIM2 */
    RCC->APB1ENR |= RCC_APB1ENR_TIM2EN;

    /* Tam dung timer trong khi cau hinh */
    TIM2->CR1 = 0U;

    /* Prescaler va chu ky */
    TIM2->PSC = PWM_PRESCALER;
    TIM2->ARR = PWM_PERIOD;

    /* Chon PWM mode 1 cho CH1 */
    TIM2->CCMR1 &= ~(TIM_CCMR1_OC1M |
                     TIM_CCMR1_OC1PE |
                     TIM_CCMR1_OC2M |
                     TIM_CCMR1_OC2PE);

    TIM2->CCMR1 |= TIM_CCMR1_OC1M_1 |
                   TIM_CCMR1_OC1M_2 |
                   TIM_CCMR1_OC1PE;

    /* Chon PWM mode 1 cho CH2 */
    TIM2->CCMR1 |= TIM_CCMR1_OC2M_1 |
                   TIM_CCMR1_OC2M_2 |
                   TIM_CCMR1_OC2PE;

    /* Chon PWM mode 1 cho CH3 */
    TIM2->CCMR2 &= ~(TIM_CCMR2_OC3M |
                     TIM_CCMR2_OC3PE);

    TIM2->CCMR2 |= TIM_CCMR2_OC3M_1 |
                   TIM_CCMR2_OC3M_2 |
                   TIM_CCMR2_OC3PE;

    /* Bat output compare CH1, CH2, CH3 */
    TIM2->CCER &= ~(TIM_CCER_CC1P |
                    TIM_CCER_CC2P |
                    TIM_CCER_CC3P);

    TIM2->CCER |= TIM_CCER_CC1E |
                  TIM_CCER_CC2E |
                  TIM_CCER_CC3E;

    /* Khoi tao do sang ban dau = 0% */
    TIM2->CCR1 = 0U;
    TIM2->CCR2 = 0U;
    TIM2->CCR3 = 0U;

    /* Nap lai PSC va ARR */
    TIM2->EGR = TIM_EGR_UG;

    /* Cho phep preload ARR */
    TIM2->CR1 |= TIM_CR1_ARPE;

    /* Bat timer */
    TIM2->CR1 |= TIM_CR1_CEN;
}

/* =========================================================
 * DOC TRANG THAI NUT NHAN
 * Tra ve 1 neu dang nhan, 0 neu khong nhan.
 * ========================================================= */

static uint8_t Button_IsPressed(uint32_t pin)
{
    return ((GPIOB->IDR & (1U << pin)) == 0U) ? 1U : 0U;
}

/* =========================================================
 * CAP NHAT DO SANG LED
 * ========================================================= */

static void LED_SetBrightness(uint8_t led, uint8_t brightness)
{
    uint32_t compare_value;

    if (brightness > 100U)
    {
        brightness = 100U;
    }

    compare_value = ((uint32_t)brightness * (PWM_PERIOD + 1U)) / 100U;

    switch (led)
    {
        case 0U:
            TIM2->CCR1 = compare_value;
            break;

        case 1U:
            TIM2->CCR2 = compare_value;
            break;

        case 2U:
            TIM2->CCR3 = compare_value;
            break;

        default:
            break;
    }
}

/* =========================================================
 * TASK LED CHUNG
 * Moi task nhan lenh do sang qua Queue rieng.
 * ========================================================= */

static void LED_Task_Common(uint8_t led, QueueHandle_t queue)
{
    uint8_t brightness = 0U;
    uint8_t new_brightness;

    LED_SetBrightness(led, brightness);

    for (;;)
    {
        if (xQueueReceive(queue,
                          &new_brightness,
                          portMAX_DELAY) == pdPASS)
        {
            brightness = new_brightness;
            LED_SetBrightness(led, brightness);
        }
    }
}

/* =========================================================
 * TASK LED1
 * ========================================================= */

static void LED1_Task(void *argument)
{
    (void)argument;

    LED_Task_Common(0U, ledQueue[0]);
}

/* =========================================================
 * TASK LED2
 * ========================================================= */

static void LED2_Task(void *argument)
{
    (void)argument;

    LED_Task_Common(1U, ledQueue[1]);
}

/* =========================================================
 * TASK LED3
 * ========================================================= */

static void LED3_Task(void *argument)
{
    (void)argument;

    LED_Task_Common(2U, ledQueue[2]);
}

/* =========================================================
 * TASK NUT NHAN
 *
 * SELECT: chuyen LED dang duoc chon
 * UP: tang do sang 10%
 * DOWN: giam do sang 10%
 *
 * Queue gui lenh den task LED tuong ung.
 * ========================================================= */

static void Button_Task(void *argument)
{
    (void)argument;

    uint8_t selected_led = 0U;
    uint8_t brightness[LED_COUNT] = {0U, 0U, 0U};

    uint8_t current_select;
    uint8_t current_up;
    uint8_t current_down;

    uint8_t previous_select = 0U;
    uint8_t previous_up = 0U;
    uint8_t previous_down = 0U;

    uint8_t stable_select = 0U;
    uint8_t stable_up = 0U;
    uint8_t stable_down = 0U;

    uint8_t count_select = 0U;
    uint8_t count_up = 0U;
    uint8_t count_down = 0U;

    for (;;)
    {
        current_select = Button_IsPressed(BUTTON_SELECT);
        current_up = Button_IsPressed(BUTTON_UP);
        current_down = Button_IsPressed(BUTTON_DOWN);

        /*
         * Chuyen LED khi SELECT duoc nhan.
         * Chi xu ly khi trang thai da on dinh.
         */
        if (current_select == stable_select)
        {
            count_select = 0U;
        }
        else
        {
            count_select++;

            if (count_select >= 3U)
            {
                stable_select = current_select;
                count_select = 0U;

                if (stable_select != 0U)
                {
                    selected_led++;

                    if (selected_led >= LED_COUNT)
                    {
                        selected_led = 0U;
                    }
                }
            }
        }

        /*
         * Tang do sang khi UP duoc nhan.
         */
        if (current_up == stable_up)
        {
            count_up = 0U;
        }
        else
        {
            count_up++;

            if (count_up >= 3U)
            {
                stable_up = current_up;
                count_up = 0U;

                if (stable_up != 0U)
                {
                    if (brightness[selected_led] < 100U)
                    {
                        brightness[selected_led] += BRIGHTNESS_STEP;
                    }

                    xQueueOverwrite(
                        ledQueue[selected_led],
                        &brightness[selected_led]
                    );
                }
            }
        }

        /*
         * Giam do sang khi DOWN duoc nhan.
         */
        if (current_down == stable_down)
        {
            count_down = 0U;
        }
        else
        {
            count_down++;
        if (stable_down != 0U)
{
    /* TEST: Nhan DOWN thi tang do sang */
    if (brightness[selected_led] < 100U)
    {
        brightness[selected_led] += BRIGHTNESS_STEP;
    }

    xQueueOverwrite(
        ledQueue[selected_led],
        &brightness[selected_led]
    );
}

            }
        }

        previous_select = current_select;
        previous_up = current_up;
        previous_down = current_down;

        (void)previous_select;
        (void)previous_up;
        (void)previous_down;

        vTaskDelay(pdMS_TO_TICKS(10U));
    }
}
/* =========================================================
 * STACK OVERFLOW HOOK
 *
 * Bat buoc khi configCHECK_FOR_STACK_OVERFLOW = 2.
 * Phai nam ngoai main().
 * ========================================================= */

void vApplicationStackOverflowHook(TaskHandle_t xTask,
                                   char *pcTaskName)
{
    (void)xTask;
    (void)pcTaskName;

    taskDISABLE_INTERRUPTS();

    for (;;)
    {
    }
}

/* =========================================================
 * MAIN
 * ========================================================= */

int main(void)
{
    /* Cau hinh clock */
    Clock_Init();

    /* Cau hinh GPIO */
    GPIO_Init();

    /* Cau hinh PWM */
    PWM_Init();

    /* Tao Queue cho tung LED */
    for (uint32_t i = 0U; i < LED_COUNT; i++)
    {
        ledQueue[i] = xQueueCreate(1U, sizeof(uint8_t));

        if (ledQueue[i] == NULL)
        {
            while (1)
            {
            }
        }
    }

    /* Tao task LED1 */
    if (xTaskCreate(LED1_Task,
                    "LED1",
                    128U,
                    NULL,
                    2U,
                    NULL) != pdPASS)
    {
        while (1)
        {
        }
    }

    /* Tao task LED2 */
    if (xTaskCreate(LED2_Task,
                    "LED2",
                    128U,
                    NULL,
                    2U,
                    NULL) != pdPASS)
    {
        while (1)
        {
        }
    }

    /* Tao task LED3 */
    if (xTaskCreate(LED3_Task,
                    "LED3",
                    128U,
                    NULL,
                    2U,
                    NULL) != pdPASS)
    {
        while (1)
        {
        }
    }

    /* Tao task nut nhan */
    if (xTaskCreate(Button_Task,
                    "BUTTON",
                    192U,
                    NULL,
                    3U,
                    NULL) != pdPASS)
    {
        while (1)
        {
        }
    }

    /* Khoi dong FreeRTOS Scheduler */
    vTaskStartScheduler();

    /* Neu scheduler khong khoi dong */
    while (1)
    {
    }
}
